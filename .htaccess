# ============================================================
# .htaccess — conoceteyreconocete.com
# Generado: 25/05/2026
# Basado en: rutaestrategica.consulting (repo RE_web/main)
# Adaptaciones: sin re-chat-proxy, sin Cloudflare AI, 
#               CSP ajustada para Supabase
# ============================================================

# ------------------------------------------------------------
# 1. FORZAR HTTPS (301 permanente)
# ------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------
# 2. HEADERS DE SEGURIDAD
# ------------------------------------------------------------
<IfModule mod_headers.c>

    # HSTS — 1 año, incluye subdominios
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Sniffing de contenido
    Header always set X-Content-Type-Options "nosniff"

    # Referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy — sin cámara, micrófono ni geolocalización
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # XSS (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"

    # CSP — adaptada para CYR:
    #   - Supabase (firmas, base de datos)
    #   - Sin api.anthropic.com ni Cloudflare Workers
    Header always set Content-Security-Policy "\
default-src 'self'; \
script-src 'self' 'unsafe-inline' 'unsafe-eval' \
    cdn.jsdelivr.net \
    cdnjs.cloudflare.com \
    d3js.org \
    unpkg.com; \
style-src 'self' 'unsafe-inline' \
    fonts.googleapis.com \
    cdn.jsdelivr.net \
    cdnjs.cloudflare.com; \
font-src 'self' \
    fonts.gstatic.com \
    data:; \
img-src 'self' data: blob: \
    *.supabase.co \
    *.supabase.in \
    upload.wikimedia.org \
    commons.wikimedia.org; \
connect-src 'self' \
    https://swbbcidwsbksdxxipedo.supabase.co \
    https://swbbcidwsbksdxxipedo.supabase.in; \
frame-src 'none'; \
object-src 'none'; \
base-uri 'self'; \
form-action 'self' \
    https://swbbcidwsbksdxxipedo.supabase.co;"

</IfModule>

# ------------------------------------------------------------
# 3. PROTECCIÓN DE ARCHIVOS SENSIBLES
# ------------------------------------------------------------
<FilesMatch "(^\.htaccess|^\.htpasswd|^\.env|^\.git|wp-config\.php|composer\.json|composer\.lock|package\.json|package-lock\.json|yarn\.lock|\.log$|\.sql$|\.bak$|\.backup$|\.swp$|~$)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquear acceso a directorios ocultos
RedirectMatch 404 /\..*

# ------------------------------------------------------------
# 4. CACHÉ INTELIGENTE POR TIPO MIME
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — sin caché (contenido dinámico)
    ExpiresByType text/html                         "access plus 0 seconds"

    # CSS y JS — 1 mes
    ExpiresByType text/css                          "access plus 1 month"
    ExpiresByType application/javascript            "access plus 1 month"
    ExpiresByType text/javascript                   "access plus 1 month"

    # Imágenes — 1 año
    ExpiresByType image/png                         "access plus 1 year"
    ExpiresByType image/jpg                         "access plus 1 year"
    ExpiresByType image/jpeg                        "access plus 1 year"
    ExpiresByType image/gif                         "access plus 1 year"
    ExpiresByType image/svg+xml                     "access plus 1 year"
    ExpiresByType image/webp                        "access plus 1 year"
    ExpiresByType image/x-icon                      "access plus 1 year"
    ExpiresByType image/ico                         "access plus 1 year"

    # Fuentes — 1 año
    ExpiresByType font/woff                         "access plus 1 year"
    ExpiresByType font/woff2                        "access plus 1 year"
    ExpiresByType application/font-woff             "access plus 1 year"
    ExpiresByType application/font-woff2            "access plus 1 year"

    # JSON (datos de pueblos)
    ExpiresByType application/json                  "access plus 1 day"

    # PDFs
    ExpiresByType application/pdf                   "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # Evitar caché en HTML
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Cache-Control en assets estáticos
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # JSON con revalidación diaria
    <FilesMatch "\.json$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------
# 5. DESCARGA FORZADA DE PDFs
# ------------------------------------------------------------
<FilesMatch "\.pdf$">
    Header set Content-Disposition "attachment"
</FilesMatch>

# ------------------------------------------------------------
# 6. COMPRESIÓN GZIP
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2

    # No comprimir lo que ya está comprimido
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|woff2?|zip|gz|bz2)$ no-gzip dont-vary
</IfModule>

# ------------------------------------------------------------
# 7. OCULTAR VERSIÓN DEL SERVIDOR
# ------------------------------------------------------------
ServerSignature Off

# ------------------------------------------------------------
# 8. RUTAS LIMPIAS — SPA fallback
#    (para el módulo /pueblos-indigenas/ cuando sea SPA)
# ------------------------------------------------------------
RewriteEngine On
RewriteBase /

# Archivos y carpetas que sí existen → servir directo
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# /pueblos-indigenas/* → index.html del módulo
RewriteRule ^pueblos-indigenas/(.*)$ /pueblos-indigenas/index.html [L]

# 404 general → index principal
ErrorDocument 404 /index.html
